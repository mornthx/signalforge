# Claude Code: ignore in-progress HALT files; resolved ones are committed
.claude/halt/*.inprogress

# M15 V0.2 — local-only secrets + ephemeral test output
# Per M15-concerns.md C7 (public-repo security): vision-LLM API keys
# (Xiaomi MiMo or any other) live in operator-local environment only;
# never in the repo. Any .env file is ignored.
.env
.env.local
.env.*
.env.*.local

# Per M15-concerns.md C4: tests/screenshots/ is ephemeral test output
# (per-CI-run captures); committed baselines live in
# tests/visual/baselines/.
tests/screenshots/

# Benchmark output is produced by local/soak runs; source benchmarks live
# under tests/benchmark/.
tests/benchmark/results/

# Python bytecode caches (M15 visual harness)
__pycache__/
*.pyc

# M16 S0.5 spike workdir (per M16-concerns.md §C7). Inter-Regular.otf
# fetched via tests/visual/scripts/setup_m16_spike.sh; ephemeral until
# S4 lands proper resources/fonts/ + Qt resource compile.
.m16-spike/

# Local operator helpers and dependency caches.
scripts/fix_codex_sandbox_permissions.sh
tests/visual/scripts/capture_hardware_rhi_chart.py
tools/crash_test/_deps/
