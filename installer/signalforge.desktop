[Desktop Entry]
Version=1.0
Type=Application
Name=SignalForge
GenericName=Signal Visualization
Comment=Real-time signal visualization and recording for embedded-device bring-up
Exec=/usr/local/bin/signalforge %f
Icon=signalforge
Terminal=false
