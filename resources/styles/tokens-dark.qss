/*
 * GENERATED FROM resources/styles/tokens.json — DO NOT EDIT MANUALLY
 * Generator: tools/generate_style_assets.py
 * Run `--check` to verify freshness (M16 R15 / H12)
 * tokens.json version 1.2; theme=dark
 *
 * M16 S2: token snippet scaffold. S4 SignalForgeStyle loads this
 * via QApplication::setStyleSheet after Fusion + palette init.
 * QSS discipline (per manifesto + spec §3 M16.4): objectName /
 * class-name / dynamic-property selectors only; no `*` or deep
 * descendants; no hot-path setStyleSheet.
 */

/* ===== Top-level surfaces ===== */
QMainWindow {
    background-color: #15171c;
    color: #f4f6f8;
}

QMenuBar {
    background-color: #15171c;
    color: #f4f6f8;
    border-bottom: 1px solid #3b414d;
    padding: 0 4px;
}
QMenuBar::item {
    padding: 4px 8px;
}
QMenu {
    background-color: #1d2027;
    color: #f4f6f8;
    border: 1px solid #3b414d;
    padding: 4px;
}
QMenu::item {
    padding: 4px 24px 4px 8px;
}

QToolBar {
    background-color: #15171c;
    border: none;
    border-bottom: 1px solid #3b414d;
    spacing: 4px;
    padding: 4px;
}
QToolBar::separator {
    background-color: #3b414d;
    width: 1px;
    margin: 4px;
}

QDockWidget {
    background-color: #15171c;
    color: #f4f6f8;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background-color: #15171c;
    color: #f4f6f8;
    border-bottom: 1px solid #3b414d;
    padding: 4px 8px;
}

QStatusBar {
    background-color: #272b34;
    color: #c2c7d0;
    border-top: 1px solid #3b414d;
}
QSplitter::handle {
    background-color: #3b414d;
}
QSplitter::handle:hover {
    background-color: #7fb2ff;
}

/* ===== Controls ===== */
QPushButton, QToolButton {
    background-color: #272b34;
    color: #f4f6f8;
    border: 1px solid #3b414d;
    padding: 4px 8px;
}
QPushButton:hover, QToolButton:hover {
    border-color: #7fb2ff;
}
QPushButton:pressed, QToolButton:pressed {
    background-color: #3b414d;
}
QPushButton:focus, QToolButton:focus {
    border: 2px solid #7fb2ff;
}
QPushButton:disabled, QToolButton:disabled {
    color: #777f8d;
}
QPushButton[class="primary"] {
    background-color: #7fb2ff;
    color: #15171c;
    border: 1px solid #7fb2ff;
}
QPushButton[class="primary"]:hover {
    border: 2px solid #f4f6f8;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #1d2027;
    color: #f4f6f8;
    border: 1px solid #3b414d;
    padding: 4px 8px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QSlider:focus, QToolButton:focus, QListWidget:focus, QTreeView:focus {
    border: 2px solid #7fb2ff;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #7fb2ff;
    color: #15171c;
}
QListWidget, QTreeView {
    background-color: #1d2027;
    color: #f4f6f8;
    border: 1px solid #3b414d;
}
QListWidget::item, QTreeView::item {
    padding: 4px 8px;
}
QListWidget::item:selected, QTreeView::item:selected {
    background-color: #7fb2ff;
    color: #15171c;
}

/* ===== Panel chrome ===== */
QFrame#chartFrame, QFrame#chartEmptyState {
    background-color: #1d2027;
    border: 1px solid #3b414d;
}
QFrame#statusStrip {
    background-color: #272b34;
}
QFrame#statusCell {
    border-left: 1px solid #3b414d;
}
QHeaderView::section, QFrame#panelHeader {
    background-color: #272b34;
    color: #c2c7d0;
    border: none;
    border-bottom: 1px solid #3b414d;
    padding: 4px 8px;
}

/* ===== Status-bar semantic classes (consumed by M17 widgets) ===== */
QLabel[class="status-idle"]         { color: #c2c7d0; }
QLabel[class="status-connecting"]   { color: #ffd166; }
QLabel[class="status-connected"]    { color: #68d979; }
QLabel[class="status-disconnecting"]{ color: #ffd166; }
QLabel[class="status-error"]        { color: #ff6b5f; }
QLabel[class="mode-live"]           { color: #68d979; }
QLabel[class="mode-recording"]      { color: #ff6b5f; }
QLabel[class="mode-replay"]         { color: #7fb2ff; }
QLabel[class="mode-paused"]         { color: #ffd166; }
QLabel[class="mode-ended"]          { color: #c2c7d0; }
QLabel[class="severity-info"]       { color: #c2c7d0; }
QLabel[class="severity-warning"]    { color: #ffd166; }
QLabel[class="severity-error"]      { color: #ff6b5f; }

/* ===== Typography hooks ===== */
QLabel[class="display"]  { font-size: 18px; font-weight: 500; }
QLabel[class="heading"]  { font-size: 14px; font-weight: 500; }
QLabel[class="caption"]  { font-size: 11px; color: #c2c7d0; }
QLabel[class="mono"]     { font-family: "JetBrains Mono"; font-size: 12px; }

/* ===== Workbench frame (M34 redesign) ===== */
/* Activity rail, segmented context switch, inspector, drawer, status
   chips, empty state. objectName-scoped so they only style the new
   frame — see src/workbench/. */
QFrame#workbenchTopBar {
    background-color: #15171c;
    border-bottom: 1px solid #3b414d;
}
QFrame#activityRail {
    background-color: #272b34;
    border-right: 1px solid #3b414d;
}
QToolButton#railButton {
    background-color: transparent;
    color: #c2c7d0;
    border: none;
    border-left: 2px solid transparent;
    padding: 8px 4px;
}
QToolButton#railButton:hover {
    color: #f4f6f8;
    background-color: #1d2027;
}
QToolButton#railButton:checked {
    color: #7fb2ff;
    border-left: 2px solid #7fb2ff;
}
QToolButton#railButton:focus {
    border-left: 2px solid #7fb2ff;
}
QToolButton#segmentButton {
    background-color: transparent;
    color: #c2c7d0;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 4px 8px;
}
QToolButton#segmentButton:hover {
    color: #f4f6f8;
}
QToolButton#segmentButton:checked {
    color: #7fb2ff;
    border-bottom: 2px solid #7fb2ff;
}
QFrame#workbenchInspector {
    background-color: #272b34;
    border-left: 1px solid #3b414d;
}
QFrame#workbenchDrawer {
    background-color: #272b34;
    border-top: 1px solid #3b414d;
}
QFrame#statusChip {
    background-color: #272b34;
    border: 1px solid #3b414d;
    border-radius: 8px;
}
QFrame#statusChip QLabel {
    color: #c2c7d0;
}
QFrame#statusChip[state="connected"] QLabel,
QFrame#statusChip[state="good"] QLabel,
QFrame#statusChip[state="live"] QLabel {
    color: #68d979;
}
QFrame#statusChip[state="connecting"] QLabel,
QFrame#statusChip[state="disconnecting"] QLabel,
QFrame#statusChip[state="paused"] QLabel,
QFrame#statusChip[state="stale"] QLabel,
QFrame#statusChip[state="uncertain"] QLabel {
    color: #ffd166;
}
QFrame#statusChip[state="error"] QLabel,
QFrame#statusChip[state="bad"] QLabel,
QFrame#statusChip[state="recording"] QLabel {
    color: #ff6b5f;
}
QFrame#statusChip[state="replay"] QLabel {
    color: #7fb2ff;
}
QFrame#emptyState {
    background-color: #1d2027;
}
